{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ComInspect",
  "identifier": "io.github.kk4oda.cominspect",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ComInspect",
        "width": 1400,
        "height": 840,
        "minWidth": 860,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "publisher": "KK4ODA",
    "copyright": "Copyright (c) 2026 KK4ODA",
    "license": "MIT",
    "homepage": "https://github.com/KK4ODA/ComInspect",
    "category": "Utility",
    "shortDescription": "Serial port inventory and identity manager for amateur radio",
    "longDescription": "ComInspect shows every serial (COM) port on the computer, what device it belongs to and what it is used for. It remembers devices across reconnections and COM-number changes, shows hidden Windows ports, and lets you label radio CAT, PTT, KISS and GPS ports.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": { "section": "hamradio" },
      "rpm": { "release": "1" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDQkYxNENEOEU4MzI0RjgKUldUNEpJT096UlMvck1nUDg5TGFaaTJKSE1IekRYUnRFdkNZR0haOWVYblhDL0p4QUlWM3VFVmQK",
      "endpoints": [
        "https://github.com/KK4ODA/ComInspect/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
